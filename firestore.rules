rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Match users collection where the document ID is the phone number
    match /users/{phoneNumber} {
      allow read: if isSignedIn();

      // Allow creation if the written document contains the authenticated user's UID and matches their phone number
      allow create: if isSignedIn()
         && request.resource.data.uid == request.auth.uid
         && request.auth.token.phone_number == phoneNumber;

      // Allow updates if both the existing record and edits contain the user's UID, 
      // AND block malicious edits to Premium features or coins
      // Allow updates if:
      // Case A: The user is updating their own profile document
      // Case B: Another user is updating non-sensitive fields (ratings, call statistics, friend connections)
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid 
         && request.resource.data.uid == request.auth.uid
         // Limit coins increment to max +100 per transaction to prevent cheating
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) 
             || (request.resource.data.coins >= (resource.data.coins == null ? 0 : resource.data.coins)
                 && request.resource.data.coins - (resource.data.coins == null ? 0 : resource.data.coins) <= 100))
         // PREVENT hacking premium status
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumExpiresAt', 'premiumPlan', 'premiumStatus', 'premiumPurchasedAt'])
             || (request.resource.data.isPremium == resource.data.isPremium 
                 && request.resource.data.premiumExpiresAt == resource.data.premiumExpiresAt
                 && request.resource.data.premiumPlan == resource.data.premiumPlan
                 && request.resource.data.premiumStatus == resource.data.premiumStatus
                 && request.resource.data.premiumPurchasedAt == resource.data.premiumPurchasedAt)))
        ||
        (resource.data.uid != request.auth.uid
         // Ensure no sensitive profile or premium fields are modified by another user:
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'uid', 'phoneNumber', 'name', 'avatarUrl', 'gender', 'location', 'state', 'isOnline', 'lastSeen', 'lastActive', 'isSearching',
              'isPremium', 'premiumExpiresAt', 'premiumPlan', 'premiumStatus', 'premiumPurchasedAt'
            ])
         // Limit coins increment to max +100 per transaction for safety
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) 
             || (request.resource.data.coins >= (resource.data.coins == null ? 0 : resource.data.coins)
                 && request.resource.data.coins - (resource.data.coins == null ? 0 : resource.data.coins) <= 100)))
      );

      allow delete: if false;

      // Nested subcollections inside users document
      match /friend_requests/{requestId} {
        allow read, write: if isSignedIn();
      }
      match /friends/{friendId} {
        allow read, write: if isSignedIn();
      }
      match /call_history/{callId} {
        allow read, write: if isSignedIn();
      }
      match /practice_history/{date} {
        allow read, write: if isSignedIn();
      }
    } // Correctly closes /users/{phoneNumber}

    // Match conversations collection
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn()
         && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
         && request.auth.uid in request.resource.data.participantIds;

      // Nested messages inside a conversation thread
      match /messages/{messageId} {
        allow read: if isSignedIn()
           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn()
           && request.auth.uid == request.resource.data.senderId
           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if isSignedIn()
           && request.auth.uid == resource.data.senderId
           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // Match active peer-to-peer call sessions
    match /calls/{callId} {
      allow read, create, update, delete: if isSignedIn();

      // Subcollections for WebRTC P2P ICE candidate signaling
      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // Match peer call rating feedback
    match /call_feedback/{feedbackId} {
      allow create: if isSignedIn()
         && request.auth.uid == request.resource.data.raterId;
      allow read: if isSignedIn()
         && request.auth.uid == resource.data.raterId;
    }

    // Supports active write transactions targeting feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
         && request.auth.uid == request.resource.data.raterId;
      allow read: if isSignedIn()
         && request.auth.uid == resource.data.raterId;
    }

    // Match abuse and community safety reports
    match /reports/{reportId} {
      allow create: if isSignedIn()
         && request.auth.uid == request.resource.data.reporterId;
      allow read: if false;
    }

    // Match matchmaking Pool rules for atomic P2P matching queue
    match /matchmaking_pool/{userId} {
      allow read, write, delete: if isSignedIn();
    }
  }
}
